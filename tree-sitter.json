{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "aiscript",
      "camelcase": "AiScript",
      "title": "AiScript",
      "scope": "source.aiscript",
      "file-types": [
        "ais"
      ],
      "injection-regex": "^aiscript$",
      "class-name": "TreeSitterAiscript"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Aiscript grammar for tree-sitter",
    "authors": [
      {
        "name": "aiscript-dev",
        "url": "https://github.com/aiscript-dev"
      }
    ],
    "links": {
      "repository": "https://github.com/aiscript-dev/tree-sitter-aiscript"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": true,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
