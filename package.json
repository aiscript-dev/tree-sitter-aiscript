{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@aiscript-dev/tree-sitter-aiscript",
  "version": "0.1.0",
  "description": "AiScript grammar for tree-sitter",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./queries/*": {
      "default": "./queries/*"
    },
    "./tree-sitter-aiscript.wasm": {
      "default": "./tree-sitter-aiscript.wasm"
    }
  },
  "scripts": {
    "prepare": "pnpm run build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "dev": "pnpm nodemon -w . -e js -x 'tree-sitter generate; pnpm run start -q'",
    "build:lib": "node scripts/generate-types.ts && tsc -p ./tsconfig.build.jsonc",
    "build:wasm": "tree-sitter build --wasm",
    "build": "pnpm run \"/^build:/\""
  },
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "aiscript"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "prebuilds/**",
    "queries/*",
    "src/**",
    "*.wasm",
    "dist/**"
  ],
  "devDependencies": {
    "@types/node": "^26.4.0",
    "nodemon": "^3.1.14",
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.13"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0",
    "web-tree-sitter": "^0.26.13"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  }
}
