{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@aiscript-dev/tree-sitter-aiscript",
  "version": "0.1.0",
  "description": "AiScript grammar for tree-sitter",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "default": "./bindings/node/index.js",
      "types": "./bindings/node/index.d.ts"
    },
    "./web": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tree-sitter-aiscript.wasm": {
      "default": "./tree-sitter-aiscript.wasm"
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js",
    "dev": "pnpm nodemon -w . -e js -x 'tree-sitter generate; pnpm run start -q'",
    "build:lib": "tsc -p ./tsconfig.build.jsonc"
  },
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "aiscript"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4",
    "web-tree-sitter": "^0.26.13"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "nodemon": "^3.1.14",
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.13"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  }
}
